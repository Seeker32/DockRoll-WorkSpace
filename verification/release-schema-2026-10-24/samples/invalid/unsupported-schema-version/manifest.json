{
  "schemaVersion": "1.1",
  "releaseId": "rel-20261024-single-001",
  "appId": "demo-single",
  "releaseType": "single_container",
  "createdAt": "2026-10-24T04:00:00Z",
  "metadata": {
    "appVersion": "1.0.0",
    "description": "Single-container reference release for the M0 manifest contract."
  },
  "compatibility": {
    "os": [
      "linux"
    ],
    "arch": [
      "amd64",
      "arm64"
    ],
    "minAgentVersion": "0.1.0",
    "minDockerVersion": "29.0.0",
    "minComposeVersion": "5.0.1"
  },
  "ownership": {
    "owner": "ota-team",
    "composeProjectName": "demo-single",
    "labels": {
      "io.dockroll.managed": "true",
      "io.dockroll.app-id": "demo-single",
      "io.dockroll.release-id": "rel-20261024-single-001",
      "io.dockroll.owner": "ota-team"
    }
  },
  "applyPolicy": {
    "strategy": "restart_container"
  },
  "health": {
    "check": {
      "type": "http",
      "path": "/healthz",
      "port": 80,
      "scheme": "http",
      "expectedStatus": 200
    },
    "intervalSeconds": 10,
    "timeoutSeconds": 3,
    "retries": 3,
    "startupGraceSeconds": 20,
    "observationWindowSeconds": 90,
    "successCriteria": "all_services_healthy"
  },
  "rollback": {
    "strategy": "previous_release",
    "maxAttempts": 1,
    "failureAction": "escalate",
    "preserveVolumes": true,
    "restoreServiceSet": true,
    "deadlineSeconds": 180
  },
  "container": {
    "image": {
      "repository": "docker.io/library/nginx",
      "digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    },
    "command": [
      "nginx",
      "-g",
      "daemon off;"
    ],
    "env": [
      {
        "name": "APP_ENV",
        "value": "production"
      },
      {
        "name": "DB_PASSWORD",
        "secretRef": "DB_PASSWORD"
      }
    ],
    "ports": [
      {
        "hostIp": "127.0.0.1",
        "hostPort": 18080,
        "containerPort": 80,
        "protocol": "tcp"
      }
    ],
    "mounts": [
      {
        "type": "bind",
        "source": "/srv/demo-single/config",
        "target": "/etc/nginx/conf.d",
        "readOnly": true
      }
    ],
    "network": {
      "mode": "bridge"
    },
    "restartPolicy": {
      "name": "unless-stopped"
    },
    "resources": {
      "cpuMillicores": 500,
      "memoryBytes": 268435456,
      "pidsLimit": 128
    },
    "stopGracePeriodSeconds": 30
  },
  "secrets": [
    {
      "name": "DB_PASSWORD",
      "provider": "file",
      "ref": "/run/dockroll-secrets/db_password"
    }
  ],
  "signature": {
    "algorithm": "ed25519",
    "keyId": "test-fixture-ed25519-2026",
    "signedAt": "2026-10-24T04:00:00Z",
    "canonicalization": "RFC8785",
    "signature": "gmOBmAcEO9ZlTcWPUcW3BFNPNfkK8qJ1cHgvk22vPgUSHtARvnV/sEg6iB4egHKm8qHcoNrGKJzd/BHhKIyODQ=="
  },
  "sharedResources": [
    {
      "kind": "bind_path",
      "name": "demo-single-config",
      "path": "/srv/demo-single/config",
      "protection": "preserve"
    }
  ]
