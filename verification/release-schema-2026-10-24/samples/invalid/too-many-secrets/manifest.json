  "apply_policy": {
    "strategy": "restart_container"
  },
  "health": {
    "check": {
      "type": "http",
      "path": "/healthz",
      "port": 80,
      "scheme": "http",
      "expected_status": 200
    },
    "interval_seconds": 10,
    "timeout_seconds": 3,
    "retries": 3,
    "startup_grace_seconds": 20,
    "observation_window_seconds": 90,
    "success_criteria": "all_services_healthy"
  },
  "rollback": {
    "strategy": "previous_release",
    "max_attempts": 1,
    "failure_action": "escalate",
    "preserve_volumes": true,
    "restore_service_set": true,
    "deadline_seconds": 180
  },
  "container": {
    "image": {
      "repository": "docker.io/library/nginx",
      "digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    },
    "command": [
      "nginx",
      "-g",
      "daemon off;"
    ],
    "env": [
      {
        "name": "APP_ENV",
        "value": "production"
      },
      {
        "name": "DB_PASSWORD",
        "secret_ref": "DB_PASSWORD"
      }
    ],
    "ports": [
      {
        "host_ip": "127.0.0.1",
        "host_port": 18080,
        "container_port": 80,
        "protocol": "tcp"
      }
    ],
    "mounts": [
      {
        "type": "bind",
        "source": "/srv/demo-single/config",
        "target": "/etc/nginx/conf.d",
        "read_only": true
      }
    ],
    "network": {
      "mode": "bridge"
    },
    "restart_policy": {
      "name": "unless-stopped"
    },
    "resources": {
      "cpu_millicores": 500,
      "memory_bytes": 268435456,
      "pids_limit": 128
    },
    "stop_grace_period_seconds": 30
  },
