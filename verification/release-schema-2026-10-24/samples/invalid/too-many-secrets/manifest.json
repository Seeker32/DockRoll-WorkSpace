  "applyPolicy": {
    "strategy": "restart_container"
  },
  "health": {
    "check": {
      "type": "http",
      "path": "/healthz",
      "port": 80,
      "scheme": "http",
      "expectedStatus": 200
    },
    "intervalSeconds": 10,
    "timeoutSeconds": 3,
    "retries": 3,
    "startupGraceSeconds": 20,
    "observationWindowSeconds": 90,
    "successCriteria": "all_services_healthy"
  },
  "rollback": {
    "strategy": "previous_release",
    "maxAttempts": 1,
    "failureAction": "escalate",
    "preserveVolumes": true,
    "restoreServiceSet": true,
    "deadlineSeconds": 180
  },
  "container": {
    "image": {
      "repository": "docker.io/library/nginx",
      "digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    },
    "command": [
      "nginx",
      "-g",
      "daemon off;"
    ],
    "env": [
      {
        "name": "APP_ENV",
        "value": "production"
      },
      {
        "name": "DB_PASSWORD",
        "secretRef": "DB_PASSWORD"
      }
    ],
    "ports": [
      {
        "hostIp": "127.0.0.1",
        "hostPort": 18080,
        "containerPort": 80,
        "protocol": "tcp"
      }
    ],
    "mounts": [
      {
        "type": "bind",
        "source": "/srv/demo-single/config",
        "target": "/etc/nginx/conf.d",
        "readOnly": true
      }
    ],
    "network": {
      "mode": "bridge"
    },
    "restartPolicy": {
      "name": "unless-stopped"
    },
    "resources": {
      "cpuMillicores": 500,
      "memoryBytes": 268435456,
      "pidsLimit": 128
    },
    "stopGracePeriodSeconds": 30
  },
