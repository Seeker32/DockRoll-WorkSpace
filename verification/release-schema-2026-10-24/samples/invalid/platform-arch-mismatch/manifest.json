  "apply_policy": {
    "strategy": "restart_container"
  },
  "health": {
    "check": {
      "type": "http",
      "path": "/healthz",
      "port": 80,
      "scheme": "http",
      "expected_status": 200
    },
    "interval_seconds": 10,
    "timeout_seconds": 3,
    "retries": 3,
    "startup_grace_seconds": 20,
    "observation_window_seconds": 90,
    "success_criteria": "all_services_healthy"
  },
  "rollback": {
    "strategy": "previous_release",
    "max_attempts": 1,
    "failure_action": "escalate",
    "preserve_volumes": true,
    "restore_service_set": true,
    "deadline_seconds": 180
