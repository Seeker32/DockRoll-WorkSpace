  "container": {
    "image": {
      "repository": "docker.io/library/nginx",
      "digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "platform": "linux/amd64"
    },
    "command": [
      "nginx",
      "-g",
      "daemon off;"
    ],
    "env": [
      {
        "name": "APP_ENV",
        "value": "production"
      },
      {
        "name": "DB_PASSWORD",
        "secret_ref": "DB_PASSWORD"
      }
    ],
    "ports": [
      {
        "host_ip": "127.0.0.1",
        "host_port": 18080,
        "container_port": 80,
        "protocol": "tcp"
      }
    ],
    "mounts": [
      {
        "type": "bind",
        "source": "/srv/demo-single/config",
        "target": "/etc/nginx/conf.d",
        "read_only": true
      }
    ],
    "network": {
      "mode": "bridge"
    },
    "restart_policy": {
      "name": "unless-stopped"
    },
    "resources": {
      "cpu_millicores": 500,
      "memory_bytes": 268435456,
      "pids_limit": 128
    },
    "stop_grace_period_seconds": 30
  },
  "secrets": [
    {
      "name": "DB_PASSWORD",
      "provider": "file",
      "ref": "/run/dockroll-secrets/db_password"
