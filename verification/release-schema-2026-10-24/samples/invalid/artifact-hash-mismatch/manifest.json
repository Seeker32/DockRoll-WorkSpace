    "retries": 3,
    "startupGraceSeconds": 20,
    "observationWindowSeconds": 90,
    "successCriteria": "all_services_healthy"
  },
  "rollback": {
    "strategy": "previous_release",
    "maxAttempts": 1,
    "failureAction": "escalate",
