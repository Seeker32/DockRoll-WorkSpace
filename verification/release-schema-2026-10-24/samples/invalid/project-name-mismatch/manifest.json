  "appId": "demo-compose",
  "releaseType": "compose",
  "createdAt": "2026-10-24T04:00:00Z",
  "metadata": {
    "appVersion": "1.0.0",
    "description": "Compose reference release covering adoption, service addition and shared volumes."
  },
  "compatibility": {
    "os": [
      "linux"
    ],
    "arch": [
      "amd64",
      "arm64"
    ],
    "minAgentVersion": "0.1.0",
    "minDockerVersion": "29.0.0",
    "minComposeVersion": "5.0.1"
  },
  "ownership": {
    "owner": "ota-team",
    "composeProjectName": "demo-compose-alt",
    "labels": {
      "io.dockroll.managed": "true",
      "io.dockroll.app-id": "demo-compose",
      "io.dockroll.release-id": "rel-20261024-compose-002",
      "io.dockroll.owner": "ota-team"
    }
  },
  "applyPolicy": {
    "strategy": "reload",
    "reload": {
      "command": [
        "nginx",
        "-s",
        "reload"
      ],
      "timeoutSeconds": 30,
      "service": "api"
    }
  },
  "health": {
    "check": {
      "type": "http",
      "path": "/healthz",
      "port": 80,
      "scheme": "http",
      "expectedStatus": 200,
      "service": "api"
    },
    "intervalSeconds": 10,
    "timeoutSeconds": 3,
    "retries": 3,
    "startupGraceSeconds": 20,
    "observationWindowSeconds": 90,
    "successCriteria": "primary_service_healthy"
  },
  "rollback": {
    "strategy": "previous_release",
    "maxAttempts": 1,
    "failureAction": "escalate",
    "preserveVolumes": true,
    "restoreServiceSet": true,
    "deadlineSeconds": 180
  },
  "takeover": {
    "mode": "adopt_existing",
    "existingProjectName": "demo-compose",
    "existingServices": [
      "api"
    ],
    "preserveSharedResources": [
      "demo-compose-data"
    ]
  },
  "sharedResources": [
    {
      "kind": "volume",
      "name": "demo-compose-data",
      "protection": "preserve"
    }
  ],
  "compose": {
    "file": {
      "path": "compose.yaml",
      "sha256": "8fc3100cf46c43a69c8525e45aa9352c82dfe841f887111de9907328066265ea",
