    command:
      - sh
      - -c
      - |
        set -eu
        echo "$$APP_VERSION" > /data/app-version
        exec httpd -f -p 8080 -h /www
    environment:
      APP_VERSION: "1"
    image: busybox@sha256:bdf57e528e45e4433820e045b29b4597825a1c9e38353532d90a01445013f82e
    networks:
      default: null
    volumes:
      - type: volume
        source: data
        target: /data
        volume: {}
      - type: bind
        source: /home/seeker32/projects/ota/.wiki/evidence/compat-2026-10-24/logs/20261024T113000/matrix/5.6.1-amd64/project/www
        target: /www
      - type: bind
        source: /home/seeker32/projects/ota/.wiki/evidence/compat-2026-10-24/logs/20261024T113000/matrix/5.6.1-amd64/project/config
        target: /config
        read_only: true
    healthcheck:
      test:
        - CMD
        - wget
        - -q
        - -O
